{
  "name": "shipping-harness",
  "version": "1.13.0",
  "description": "A local-first shipping governance layer for coding agents.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "shipping-harness": "./bin/shipping-harness.mjs",
    "shiph": "./bin/shipping-harness.mjs",
    "shipping-harness-mcp": "./bin/shipping-harness-mcp.mjs",
    "shipping-harness-plugin": "./bin/shipping-harness-plugin.mjs",
    "shipping-harness-remote": "./bin/shipping-harness-remote.mjs",
    "shipping-harness-omp": "./bin/shipping-harness-omp.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "packages/",
    "schemas/",
    "config/",
    "docs/",
    "!docs/reports/**",
    "scripts/goal-runtime-smoke.mjs",
    "scripts/plugin-smoke.mjs",
    "scripts/remote-gateway-smoke.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "scripts/release-train-pilot.mjs",
    "scripts/autopilot-pilot.mjs",
    "scripts/autopilot-field-pilot.mjs",
    "scripts/goal-discovery-pilot.mjs",
    "scripts/goal-charter-pilot.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "npm run lint:custom && npm run lint:eslint",
    "lint:custom": "node scripts/lint.mjs",
    "lint:eslint": "eslint .",
    "typecheck": "npm run typecheck:custom && npm run typecheck:tsc",
    "typecheck:custom": "node scripts/typecheck.mjs",
    "typecheck:tsc": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs all",
    "test:coverage": "node scripts/run-tests.mjs all --coverage",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:adapter": "node scripts/run-tests.mjs adapter",
    "test:mcp": "node scripts/run-tests.mjs mcp",
    "test:decision": "node --test --test-reporter=spec test/unit/decision-evidence.test.mjs test/unit/decision-package.test.mjs test/unit/decision-policy.test.mjs test/adversarial/decision-attacks.test.mjs",
    "test:goals": "node --test --test-reporter=spec test/unit/goals-compiler.test.mjs test/unit/goals-freshness.test.mjs test/integration/goals-recovery.test.mjs test/integration/goals-failure-policy.test.mjs test/integration/goals-control.test.mjs test/adversarial/goals-attacks.test.mjs",
    "test:plugin": "node --test --test-reporter=spec test/plugin/*.test.mjs",
    "test:usability": "node --test --test-reporter=spec test/usability/*.test.mjs",
    "test:adversarial": "node scripts/run-tests.mjs adversarial",
    "test:omp-main": "node --test --test-reporter=spec test/omp-main-harness/*.test.mjs",
    "smoke:omp-main": "node packages/omp-main-harness/field-smoke.mjs --check",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "security": "node scripts/security-check.mjs",
    "license:check": "node scripts/license-check.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "test:omo-bridge": "node --test --test-reporter=spec test/omo/*.test.mjs",
    "test:remote": "node --test --test-reporter=spec test/remote/*.test.mjs test/adversarial/remote-attacks.test.mjs",
    "smoke:remote": "node scripts/remote-gateway-smoke.mjs --check",
    "test:stable": "node --test --test-reporter=spec test/stable/*.test.mjs test/adversarial/stable-control-attacks.test.mjs",
    "benchmark:completion": "node scripts/v1-completion-benchmark.mjs --check",
    "smoke:stable": "node scripts/v1-final-smoke.mjs --check",
    "security:inventory": "node scripts/v1-security-inventory.mjs --check",
    "verify:docs": "node scripts/v1-doc-audit.mjs",
    "acceptance:v1": "node scripts/v1-acceptance.mjs --all",
    "status:v1": "node scripts/v1-status-report.mjs",
    "test:release-train": "node --test --test-reporter=spec test/mcp/release-train.test.mjs test/adversarial/release-train-attacks.test.mjs",
    "smoke:release-train": "node scripts/release-train-pilot.mjs --check",
    "test:autopilot": "node --test --test-reporter=spec test/autopilot/*.test.mjs test/adversarial/autopilot-attacks.test.mjs test/adversarial/autopilot-field-attacks.test.mjs",
    "smoke:autopilot": "node scripts/autopilot-pilot.mjs --check",
    "test:autopilot:field": "node --test --test-reporter=spec test/autopilot/field-matrix.test.mjs test/autopilot/autopilot-performance.test.mjs test/adversarial/autopilot-field-attacks.test.mjs",
    "smoke:autopilot:field": "node scripts/autopilot-field-pilot.mjs --check",
    "test:goal-discovery": "node --test --test-reporter=spec test/mcp/goal-discovery.test.mjs test/adversarial/goal-discovery-attacks.test.mjs test/integration/decision-ledger.test.mjs test/integration/goal-discovery-performance.test.mjs",
    "smoke:goal-discovery": "node scripts/goal-discovery-pilot.mjs --check",
    "test:goal-charter": "node --test --test-reporter=spec test/unit/goal-charter.test.mjs test/integration/goal-charter-approval.test.mjs test/adversarial/goal-charter-attacks.test.mjs test/integration/goal-charter-performance.test.mjs",
    "smoke:goal-charter": "node scripts/goal-charter-pilot.mjs --check",
    "test:goal-charter:field": "node --test --test-reporter=spec test/integration/goal-direction-field.test.mjs test/adversarial/goal-direction-field-attacks.test.mjs test/integration/goal-direction-field-performance.test.mjs test/integration/goal-charter-field.test.mjs test/adversarial/goal-charter-field-attacks.test.mjs test/integration/goal-charter-field-performance.test.mjs",
    "smoke:goal-charter:field": "node scripts/goal-charter-field-pilot.mjs --check",
    "test:goal-direction:field": "npm run test:goal-charter:field",
    "smoke:goal-direction:field": "npm run smoke:goal-charter:field",
    "test:intent-gate": "node --test --test-reporter=spec test/unit/intent-gate.test.mjs test/mcp/intent-gate.test.mjs test/adversarial/intent-gate-attacks.test.mjs",
    "smoke:intent-gate": "node scripts/intent-gate-pilot.mjs --check"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  }
}
