{
  "schema": "shipping-harness/plugin-v1",
  "name": "shipping-harness",
  "displayName": "Shipping Harness",
  "version": "1.3.1",
  "localOnly": true,
  "mcp": {
    "transport": "stdio",
    "binary": "shipping-harness-mcp",
    "arbitraryCommandInput": false,
    "publicListener": false
  },
  "userFlow": [
    "shipping_start",
    "shipping_refine",
    "shipping_approve_scope",
    "shipping_execute",
    "shipping_status",
    "shipping_pause",
    "shipping_fix_blockers",
    "shipping_verify",
    "shipping_close"
  ],
  "approval": {
    "humanConfirmationRequired": true,
    "modelSelfApprovalForbidden": true
  },
  "surfaces": [
    "approval",
    "progress",
    "blocker",
    "completion",
    "evidence-detail",
    "baseline-plan",
    "project-intelligence",
    "acceptance-coverage"
  ]
}
