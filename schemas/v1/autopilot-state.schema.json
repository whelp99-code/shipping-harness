{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/autopilot-state-v1",
  "title": "Shipping Harness durable autopilot state",
  "description": "The current durable, hash-bound release-train autopilot phase. CLOSED never implies RELEASED.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys",
  "type": "object",
  "required": ["schema", "enabled", "profile", "modelAuthority", "policyHash", "releaseTrainHash", "currentRelease", "currentIndex", "phase", "resumePhase", "sequence", "lastEventHash", "lastDecisionHash", "lastAction", "lastDecision", "replanRequired", "released", "baselineSha", "startedAt", "updatedAt", "hash"],
  "properties": {
    "schema": { "const": "shipping-harness/autopilot-state-v1", "type": "string" },
    "enabled": { "type": "boolean" },
    "profile": { "enum": ["MANUAL", "LOCAL_REVERSIBLE"] },
    "modelAuthority": { "const": false },
    "policyHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "releaseTrainHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "currentRelease": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "currentIndex": { "type": "integer", "minimum": 0, "maximum": 4 },
    "phase": { "enum": ["POLICY_READY", "TRAIN_READY", "RELEASE_PREPARING", "BASELINE_PRESERVING", "CONTRACT_ACTIVATING", "IMPLEMENTING", "VERIFYING", "FIXING_BLOCKERS", "SHIPPABLE", "CLOSING", "RELEASE_CLOSED", "REPLAN_CHECK", "NEXT_RELEASE", "TRAIN_COMPLETE", "PAUSED", "ASKING", "REPLAN_REQUIRED", "STOPPED", "ABORTED"] },
    "resumePhase": { "type": ["string", "null"], "maxLength": 80 },
    "sequence": { "type": "integer", "minimum": 1 },
    "lastEventHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "lastDecisionHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "lastAction": { "type": ["string", "null"], "maxLength": 80 },
    "lastDecision": { "type": ["string", "null"], "maxLength": 20 },
    "replanRequired": { "type": "boolean" },
    "released": { "const": false },
    "baselineSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
