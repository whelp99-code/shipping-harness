{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/compatibility-v1",
  "title": "Shipping Harness stable compatibility schema",
  "description": "Internal stable v1 schema for compatibility. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "shippingVersion",
    "supportedReleases",
    "node",
    "git",
    "plugin",
    "omoRuntime",
    "mcp",
    "remote",
    "teamDag"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/compatibility-v1",
      "type": "string"
    },
    "shippingVersion": {
      "type": "string",
      "maxLength": 8192
    },
    "supportedReleases": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "node": {
      "type": "object",
      "required": [
        "minimum",
        "recommended"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recommended": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "git": {
      "type": "object",
      "required": [
        "minimum"
      ],
      "properties": {
        "minimum": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "plugin": {
      "type": "object",
      "required": [
        "upgradeFrom"
      ],
      "properties": {
        "upgradeFrom": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "omoRuntime": {
      "type": "object",
      "required": [
        "shippingBridge",
        "upstreamVersion",
        "internalOnly"
      ],
      "properties": {
        "shippingBridge": {
          "type": "string",
          "maxLength": 8192
        },
        "upstreamVersion": {
          "type": "string",
          "maxLength": 8192
        },
        "internalOnly": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "mcp": {
      "type": "object",
      "required": [
        "current",
        "legacy"
      ],
      "properties": {
        "current": {
          "type": "string",
          "maxLength": 8192
        },
        "legacy": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "remote": {
      "type": "object",
      "required": [
        "schema",
        "tlsMinimum",
        "publicListener"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "maxLength": 8192
        },
        "tlsMinimum": {
          "type": "string",
          "maxLength": 8192
        },
        "publicListener": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "teamDag": {
      "type": "object",
      "required": [
        "default",
        "entryGate"
      ],
      "properties": {
        "default": {
          "type": "string",
          "maxLength": 8192
        },
        "entryGate": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
