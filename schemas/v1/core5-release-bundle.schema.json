{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/core5-release-bundle.v1",
  "title": "Core5 release bundle v1",
  "description": "Immutable evidence lock for a Core5 verification release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundleVersion", "release", "repository", "migrationIds", "toolVersions", "modelVersions", "imageVersions", "criterionVersion", "criteria", "criteriaHash", "evidenceManifest", "createdAt", "bundleHash"],
  "properties": {
    "schema": { "const": "shipping-harness/core5-release-bundle.v1" },
    "bundleVersion": { "const": "1" },
    "release": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository": {
      "type": "object", "additionalProperties": false, "required": ["revision", "contractHash"],
      "properties": { "revision": { "type": "string", "minLength": 1, "maxLength": 128 }, "contractHash": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "migrationIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "toolVersions": { "$ref": "#/$defs/versionMap" },
    "modelVersions": { "$ref": "#/$defs/versionMap" },
    "imageVersions": { "$ref": "#/$defs/versionMap" },
    "criterionVersion": { "type": "string", "pattern": "^core5-criteria-v[0-9]+$" },
    "criteria": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
    "criteriaHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidenceManifest": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "bundleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "versionMap": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }, "maxProperties": 64 },
    "criterion": { "type": "object", "additionalProperties": false, "required": ["id", "description", "required"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "minLength": 1, "maxLength": 2000 }, "required": { "type": "boolean" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 80 }, "path": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*(?:^|/)\.\.(?:/|$)).+$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  }
}
