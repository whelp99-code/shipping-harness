{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/goal-charter-v1",
  "title": "Shipping Harness Goal Charter",
  "description": "A deterministic product-direction charter. PROPOSED has no approval binding; ACCEPTED is bound to proposal, Git, contract, baseline, Release Train, approver, and time. Neither form grants execution, approval, closure, deployment, model, or RELEASED authority.",
  "x-shipping-version": "1.0.0",
  "type": "object",
  "required": [
    "schema",
    "id",
    "status",
    "project",
    "release",
    "proposalId",
    "proposalRevision",
    "proposalHash",
    "gitSha",
    "discoveryHash",
    "directionHash",
    "candidateHash",
    "criticHash",
    "outcome",
    "primaryUser",
    "operatingBoundary",
    "value",
    "include",
    "nonGoals",
    "successCriteria",
    "assumptions",
    "rollback",
    "replanTriggers",
    "evidenceRefs",
    "binding",
    "commandAuthority",
    "approvalAuthority",
    "closureAuthority",
    "deploymentAuthority",
    "modelAuthority",
    "released",
    "hash"
  ],
  "properties": {
    "schema": { "const": "shipping-harness/goal-charter-v1" },
    "id": { "type": "string", "pattern": "^CHARTER-[a-f0-9]{12}$" },
    "status": { "enum": ["PROPOSED", "ACCEPTED"] },
    "project": { "type": "string", "minLength": 1, "maxLength": 160 },
    "release": { "type": "string", "minLength": 1, "maxLength": 80 },
    "proposalId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "proposalRevision": { "type": "integer", "minimum": 1 },
    "proposalHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "discoveryHash": { "$ref": "#/$defs/hash" },
    "directionHash": { "$ref": "#/$defs/hash" },
    "candidateHash": { "$ref": "#/$defs/hash" },
    "criticHash": { "$ref": "#/$defs/hash" },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "primaryUser": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "operatingBoundary": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "value": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "include": { "$ref": "#/$defs/stringList" },
    "nonGoals": { "$ref": "#/$defs/nonEmptyStringList" },
    "successCriteria": { "$ref": "#/$defs/nonEmptyStringList" },
    "assumptions": { "$ref": "#/$defs/stringList" },
    "rollback": { "type": "string", "minLength": 1, "maxLength": 1600 },
    "replanTriggers": { "$ref": "#/$defs/nonEmptyStringList" },
    "evidenceRefs": { "$ref": "#/$defs/nonEmptyStringList" },
    "binding": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["previewHash", "contractHash", "baselineSha", "releaseTrainHash", "approverType", "approverId", "acceptedAt"],
          "properties": {
            "previewHash": { "$ref": "#/$defs/hash" },
            "contractHash": { "$ref": "#/$defs/hash" },
            "baselineSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "releaseTrainHash": { "$ref": "#/$defs/hash" },
            "approverType": { "enum": ["human", "autopilot-policy"] },
            "approverId": { "type": "string", "minLength": 1, "maxLength": 160 },
            "acceptedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      ]
    },
    "commandAuthority": { "const": false },
    "approvalAuthority": { "const": false },
    "closureAuthority": { "const": false },
    "deploymentAuthority": { "const": false },
    "modelAuthority": { "const": false },
    "released": { "const": false },
    "hash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PROPOSED" } } },
      "then": {
        "properties": {
          "proposalHash": { "type": "null" },
          "binding": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "ACCEPTED" } } },
      "then": {
        "properties": {
          "proposalHash": { "$ref": "#/$defs/hash" },
          "binding": { "type": "object" }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringList": {
      "type": "array",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}
