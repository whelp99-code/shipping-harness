{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/health-v1",
  "title": "Shipping Harness stable health schema",
  "description": "Internal stable v1 schema for health. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "status",
    "checks",
    "internalOnly"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/health-v1",
      "type": "string"
    },
    "status": {
      "type": "string",
      "maxLength": 8192
    },
    "checks": {
      "type": "object",
      "required": [
        "shipping",
        "plugin",
        "omo",
        "remote"
      ],
      "properties": {
        "shipping": {
          "type": "string",
          "maxLength": 8192
        },
        "plugin": {
          "type": "string",
          "maxLength": 8192
        },
        "omo": {
          "type": "string",
          "maxLength": 8192
        },
        "remote": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "internalOnly": {
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
