{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/lock-v1",
  "title": "Shipping Harness stable lock schema",
  "description": "Internal stable v1 schema for lock. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "contractHash",
    "baselineSha",
    "release",
    "scopeRevision",
    "lockedAt"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/lock-v1",
      "type": "string"
    },
    "contractHash": {
      "type": "string",
      "maxLength": 256
    },
    "baselineSha": {
      "type": "string",
      "maxLength": 8192
    },
    "release": {
      "type": "string",
      "maxLength": 8192
    },
    "scopeRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lockedAt": {
      "type": "string",
      "maxLength": 8192,
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
