{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-omo-receipt/v1",
  "title": "Shipping Harness stable omoReceipt schema",
  "description": "Internal stable v1 schema for omoReceipt. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "work_order_id",
    "shipping_session_id",
    "release_id",
    "contract_hash",
    "source_git_sha",
    "result_git_sha",
    "goal_ids",
    "shipping_task_ids",
    "requirement_ids",
    "acceptance_ids",
    "status",
    "requires_shipping_verification",
    "shipping_finisher_authority",
    "terminal_replay_allowed",
    "usage",
    "path_analysis",
    "receipt_hash",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "shipping-omo-receipt/v1",
      "type": "string"
    },
    "work_order_id": {
      "type": "string",
      "maxLength": 8192
    },
    "shipping_session_id": {
      "type": "string",
      "maxLength": 8192
    },
    "release_id": {
      "type": "string",
      "maxLength": 8192
    },
    "contract_hash": {
      "type": "string",
      "maxLength": 256
    },
    "source_git_sha": {
      "type": "string",
      "maxLength": 8192
    },
    "result_git_sha": {
      "type": "string",
      "maxLength": 8192
    },
    "goal_ids": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "shipping_task_ids": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "requirement_ids": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "acceptance_ids": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "status": {
      "type": "string",
      "maxLength": 8192
    },
    "requires_shipping_verification": {
      "type": "boolean"
    },
    "shipping_finisher_authority": {
      "type": "boolean"
    },
    "terminal_replay_allowed": {
      "type": "boolean"
    },
    "usage": {
      "type": "object",
      "required": [
        "turns",
        "tool_calls",
        "continuations"
      ],
      "properties": {
        "turns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "continuations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "path_analysis": {
      "type": "object",
      "required": [
        "changed",
        "violations"
      ],
      "properties": {
        "changed": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "violations": {
          "type": "array",
          "maxItems": 256,
          "items": {}
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "receipt_hash": {
      "type": "string",
      "maxLength": 256
    },
    "signature": {
      "type": "string",
      "maxLength": 256
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
