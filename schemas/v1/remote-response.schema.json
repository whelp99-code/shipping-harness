{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-remote/response-v1",
  "title": "Shipping Harness stable remoteResponse schema",
  "description": "Internal stable v1 schema for remoteResponse. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "requestId",
    "ok",
    "result"
  ],
  "properties": {
    "schema": {
      "const": "shipping-remote/response-v1",
      "type": "string"
    },
    "requestId": {
      "type": "string",
      "maxLength": 8192
    },
    "ok": {
      "type": "boolean"
    },
    "result": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
