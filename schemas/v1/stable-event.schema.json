{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/event-v1",
  "title": "Shipping Harness stable stableEvent schema",
  "description": "Internal stable v1 schema for stableEvent. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "id",
    "time",
    "type",
    "project",
    "release",
    "severity",
    "data"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/event-v1",
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 8192
    },
    "time": {
      "type": "string",
      "maxLength": 8192,
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "maxLength": 8192
    },
    "project": {
      "type": "string",
      "maxLength": 8192
    },
    "release": {
      "type": "string",
      "maxLength": 8192
    },
    "severity": {
      "type": "string",
      "maxLength": 8192
    },
    "data": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
