{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/state-v1",
  "title": "Shipping Harness stable state schema",
  "description": "Internal stable v1 schema for state. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "state",
    "release",
    "contractHash",
    "baselineSha",
    "currentEvidenceSha",
    "lastRunId",
    "agentRuns",
    "fixCycles",
    "blockerCount",
    "nextCount",
    "ignoreCount",
    "resumeState",
    "humanStop",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/state-v1",
      "type": "string"
    },
    "state": {
      "type": "string",
      "maxLength": 8192
    },
    "release": {
      "type": "string",
      "maxLength": 8192
    },
    "contractHash": {
      "type": "string",
      "maxLength": 256
    },
    "baselineSha": {
      "type": "string",
      "maxLength": 8192
    },
    "currentEvidenceSha": {
      "type": "null"
    },
    "lastRunId": {
      "type": "null"
    },
    "agentRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fixCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "blockerCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ignoreCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resumeState": {
      "type": "string",
      "maxLength": 8192
    },
    "humanStop": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "maxLength": 8192,
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "maxLength": 8192,
      "format": "date-time"
    },
    "integrity": {
      "type": "object",
      "description": "Proof that this document was written by the engine and matches the ledger head named here. Optional: states written before v1.10 have none and read as UNVERIFIED_LEGACY.",
      "required": [
        "algorithm",
        "ledgerHead",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256",
          "type": "string"
        },
        "ledgerHead": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verifyRuns": {
      "description": "v1.10.0 Phase C: total verify runs recorded for the current release. Optional; states written before v1.10 have none and are treated as 0.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "redundantVerifyRuns": {
      "description": "v1.10.0 Phase C: consecutive verify runs that reproduced the previous run's Git SHA and per-criterion exit codes (no new evidence). Resets on any change. Optional; absent reads as 0.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "telemetry": {
      "description": "v1.10.0 Phase C: aggregated adapter-run cost telemetry. Optional; absent reads as no recorded agent-run duration.",
      "type": "object",
      "required": [
        "totalAgentDurationMs"
      ],
      "properties": {
        "totalAgentDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
