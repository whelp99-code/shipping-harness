{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shipping-harness/user-view-v1",
  "title": "Shipping Harness stable userView schema",
  "description": "Internal stable v1 schema for userView. Unknown top-level fields fail closed.",
  "x-shipping-version": "1.0.0",
  "x-owner": "Shipping Governance Core",
  "x-unknown-field-policy": "reject",
  "x-migration-owner": "packages/stable-control/migration.mjs",
  "x-canonical-hashing": "UTF-8 canonical JSON with sorted object keys where authority hashes apply",
  "x-redaction": "credentials, authorization, token, password, secret and cookie values must be redacted",
  "type": "object",
  "required": [
    "schema",
    "initialized",
    "project",
    "release",
    "coreState",
    "userState",
    "summary",
    "blockerCount",
    "goals",
    "nextAction",
    "canPause",
    "canResume",
    "canClose",
    "evidenceFresh",
    "fixCycles",
    "agentRuns"
  ],
  "properties": {
    "schema": {
      "const": "shipping-harness/user-view-v1",
      "type": "string"
    },
    "initialized": {
      "type": "boolean"
    },
    "project": {
      "type": "string",
      "maxLength": 8192
    },
    "release": {
      "type": "string",
      "maxLength": 8192
    },
    "coreState": {
      "type": "string",
      "maxLength": 8192
    },
    "userState": {
      "type": "string",
      "maxLength": 8192
    },
    "summary": {
      "type": "string",
      "maxLength": 8192
    },
    "blockerCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "goals": {
      "type": "object",
      "required": [
        "totalTasks",
        "doneTasks",
        "blockedTasks"
      ],
      "properties": {
        "totalTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "doneTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blockedTasks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "maxProperties": 128
    },
    "nextAction": {
      "type": "string",
      "maxLength": 8192
    },
    "canPause": {
      "type": "boolean"
    },
    "canResume": {
      "type": "boolean"
    },
    "canClose": {
      "type": "boolean"
    },
    "evidenceFresh": {
      "type": "boolean"
    },
    "fixCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "agentRuns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false,
  "maxProperties": 128
}
